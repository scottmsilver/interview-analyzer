# Anthropic API Key (required)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Claude Model (optional, defaults to claude-opus-5)
# Current model IDs carry no date suffix.
# Options: claude-opus-5 (default), claude-sonnet-5 (cheaper/faster), claude-haiku-4-5 (bulk)
ANTHROPIC_MODEL=claude-opus-5

# Server Configuration
PORT=9002
NODE_ENV=development

# CORS (optional - defaults to allowing all origins in development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

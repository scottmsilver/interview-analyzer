rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin (by UID document)
    function isAdminByUid() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper function to check if user is admin (by email in config)
    function isAdminByEmail() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // Combined admin check - either method works
    function isAdmin() {
      return isAdminByUid() || isAdminByEmail();
    }

    // Config collection - stores app configuration
    match /config/{configId} {
      // Anyone authenticated can read config
      allow read: if request.auth != null;
      // Only admins can write (managed via script with Admin SDK)
      allow write: if false;
    }

    // Admins collection - stores admin users (legacy UID-based)
    match /admins/{adminId} {
      // Users can read their own admin document (to check if they're admin)
      // Admins can read all admin documents
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      // Nobody can write (must be done via Firebase Console or Admin SDK)
      allow write: if false;
    }

    // Interview criteria cache - for caching web search results
    match /interviewCriteria/{type} {
      // Anyone authenticated can read cached criteria
      allow read: if request.auth != null;
      // Only admins can write/update cache
      allow write: if isAdmin();
    }

    // Users collection - stores approval status
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Allow users to create their own document on first signup
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.approved == false
                    && request.resource.data.email == request.auth.token.email;

      // Allow admins to update any user document
      // Prevent regular users from updating their own
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // Analyses collection - stores saved interview analyses
    match /analyses/{analysisId} {
      // Anyone can read (for future sharing feature)
      allow read: if true;

      // Only authenticated users can create, and only with their own userId
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Users can update their own analyses
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Users can delete their own analyses
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

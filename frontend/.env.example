# Backend API URL
#
# Local development:
VITE_API_URL=http://localhost:9002

# Production builds read frontend/.env.production, which is gitignored and so
# is NOT present in a fresh clone. Without it, `npm run build` silently falls
# back to the localhost URL above and the deployed site cannot reach the API.
#
# Before deploying, create frontend/.env.production containing:
#   VITE_API_URL=https://interview-analyzer-api.fly.dev
#
# Then verify the built bundle before shipping it:
#   grep -o 'interview-analyzer-api\.fly\.dev\|localhost:9002' dist/assets/*.js
